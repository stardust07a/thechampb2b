# ── THE CHAMP GLOBAL — yayın ortam değişkenleri ──────────────────────────────
# Vercel → Project → Settings → Environment Variables altına girilecek.
# Yıldızlı (*) olanlar zorunludur; site onlarsız ayağa kalkmaz.

# * Neon Postgres bağlantı adresi. Neon panelinden "Pooled connection" alın.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# * Oturum imzalama anahtarı. Üretmek için:  openssl rand -base64 32
AUTH_SECRET=""

# * Sitenin tam adresi. Sitemap, canonical, OG görselleri ve WhatsApp
#   mesajlarındaki ürün linkleri bunu kullanır. Sonunda / OLMAYACAK.
NEXT_PUBLIC_SITE_URL="https://thechampb2b.com"

# ── Görsel ve video depolama ─────────────────────────────────────────────────
# Vercel'de `public/` klasörü yazılabilir DEĞİLDİR. Panelden dosya yükleyebilmek
# ve 12.500 ürün görselini servis edebilmek için Vercel Blob zorunludur.
# Vercel → Storage → Create → Blob ile oluşturun, token'ı buraya yapıştırın.
BLOB_READ_WRITE_TOKEN=""

# * Görsellerin taban adresi. Blob store'un public adresi + /media
NEXT_PUBLIC_MEDIA_BASE="https://<store-id>.public.blob.vercel-storage.com/media"

# Panelden yüklenen büyük dosyalar tarayıcıdan doğrudan Blob'a gitsin diye "1".
# 0 bırakılırsa dosya sunucudan geçer ve Vercel'in 4.5 MB gövde sınırına takılır.
NEXT_PUBLIC_BLOB_ENABLED="1"

# ── E-posta ──────────────────────────────────────────────────────────────────
# Boş bırakılabilir: teklif formu yine çalışır ve kayıt panele düşer,
# sadece e-posta bildirimi gönderilmez.
RESEND_API_KEY=""
# Doğrulanmış gönderen adresi. Boşsa Resend'in test adresi kullanılır.
RESEND_FROM="THE CHAMP GLOBAL <info@thechampb2b.com>"

# ── Hız sınırı (önerilir) ─────────────────────────────────────────────────────
# Vercel'de her istek ayrı bir örneğe düşebilir; bellekteki sayaç paylaşılmaz.
# Upstash Redis tanımlıysa sınır tüm örnekler arasında ortak sayılır.
# Vercel → Storage → Upstash Redis ile oluşturun. Boş bırakılırsa sınır
# bellekte tutulur (çalışır, ama örnek başına ayrı sayar).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Sadece ilk kurulumda (seed) ──────────────────────────────────────────────
# Panel yönetici hesabı bir kez oluşturulur. Oluşturduktan sonra bu iki
# değişkeni Vercel'den SİLİN.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
