// THE CHAMP GLOBAL — B2B
// Şema brief §5'e birebir uyar. Değişiklik yapmadan önce docs/THE_CHAMP_B2B_BUILD_BRIEF.md §5'e bak.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id         String  @id @default(cuid())
  slug       String  @unique
  order      Int     @default(0)
  active     Boolean @default(true)
  coverImage String?

  // varsayılan üretim bilgileri — ürün boş bırakırsa buradan gelir
  fabric       Json?
  gsm          Int?
  moq          Int?
  leadTimeDays String?
  packaging    Json?
  privateLabel Boolean @default(true)
  printType    Json?

  // varsayılan fiyatlar (USD)
  price100  Decimal? @db.Decimal(10, 2)
  price300  Decimal? @db.Decimal(10, 2)
  price500  Decimal? @db.Decimal(10, 2)
  price1000 Decimal? @db.Decimal(10, 2)

  translations CategoryTranslation[]
  products     Product[]

  @@index([active, order])
}

model CategoryTranslation {
  id             String  @id @default(cuid())
  categoryId     String
  locale         String
  name           String
  description    String?
  seoTitle       String?
  seoDescription String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale])
}

model Product {
  id          String  @id @default(cuid())
  productCode String  @unique
  modelCode   String?
  slug        String  @unique
  categoryId  String
  subcategory String?
  section     String
  audience    String
  status      String  @default("published")

  // ürün bazlı istisnalar — null ise kategori varsayılanı kullanılır
  fabric       Json?
  gsm          Int?
  moq          Int?
  leadTimeDays String?
  packaging    Json?
  privateLabel Boolean?
  printType    Json?

  price100         Decimal? @db.Decimal(10, 2)
  price300         Decimal? @db.Decimal(10, 2)
  price500         Decimal? @db.Decimal(10, 2)
  price1000        Decimal? @db.Decimal(10, 2)
  priceEurOverride Json?

  isBestSeller Boolean @default(false)
  isFeatured   Boolean @default(false)
  isNew        Boolean @default(false)
  sortOrder    Int     @default(0)

  // DAHİLİ — asla public API/HTML'e sızdırma (brief §6.2/6)
  sourceUrl String?
  retailTry Decimal? @db.Decimal(12, 2)

  // import kalite raporu için
  importWarnings String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id])
  translations ProductTranslation[]
  variants     Variant[]
  inquiryItems InquiryItem[]

  @@index([categoryId, status])
  @@index([status, sortOrder])
  @@index([section])
  @@index([isBestSeller])
  @@index([isFeatured])
  @@index([isNew])
}

model ProductTranslation {
  id               String  @id @default(cuid())
  productId        String
  locale           String
  name             String
  shortDescription String?
  description      String?
  seoTitle         String?
  seoDescription   String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale])
}

model Variant {
  id        String   @id @default(cuid())
  productId String
  color     String
  colorTr   String?
  colorHex  String?
  sizes     String[]
  images    String[]
  sortOrder Int      @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sortOrder])
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  company   String?
  country   String?
  email     String
  phone     String?
  interest  String?
  estimatedQuantity String?
  message   String?
  locale    String
  status    String   @default("new")
  adminNote String?
  fileUrl   String?
  createdAt DateTime @default(now())

  items InquiryItem[]

  @@index([status, createdAt])
}

model InquiryItem {
  id          String  @id @default(cuid())
  inquiryId   String
  productId   String?
  productCode String
  productName String
  color       String?
  sizeRun     String?
  quantity    Int?

  inquiry Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([inquiryId])
}

model Setting {
  key   String @id
  value Json
}

model HomeSection {
  id         String   @id @default(cuid())
  key        String   @unique
  enabled    Boolean  @default(true)
  limit      Int      @default(8)
  titles     Json
  productIds String[]
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

model MediaAsset {
  id        String   @id @default(cuid())
  key       String   @unique
  url       String
  kind      String   @default("factory")
  alt       Json?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([kind, sortOrder])
}
